{
  "name": "@poyetik/playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Poyetik playground: a 440 Hz sine from the Rust engine, with an on/off button and a live oscilloscope. Grows into the editor.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4393 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@poyetik/engine-wasm": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@poyetik/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.6",
    "vitest": "catalog:"
  }
}
