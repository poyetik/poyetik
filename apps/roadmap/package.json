{
  "name": "@poyetik/roadmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "poyetik roadmap kanban: data in board.json (git), CLI driven by Claude, read-only web page.",
  "scripts": {
    "roadmap": "node src/cli/bin.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4173",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:mutation && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "catalog:",
    "@poyetik/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "astro": "^7.4.7",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  }
}
