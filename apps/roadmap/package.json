{
  "name": "@poyetik/roadmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "poyetik roadmap kanban: data in board.json (git), CLI driven by Claude, read-only web page.",
  "scripts": {
    "roadmap": "node src/cli/bin.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4173",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:mutation && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "astro": "^7.4.7",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
