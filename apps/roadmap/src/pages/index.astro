---
import rawBoard from "../../board.json";
import Board from "../components/Board.astro";
import { parseBoard } from "../lib/board.ts";
import { toView } from "../lib/view.ts";
import { pagePolicy } from "../lib/csp.ts";

// Validated at build time: an invalid board.json fails the build.
const view = toView(parseBoard(rawBoard));
// No policy on the dev server only, which injects inline styles and scripts (see pagePolicy).
const policy = pagePolicy(import.meta.env.MODE);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {policy !== undefined && <meta http-equiv="Content-Security-Policy" content={policy} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{view.title} · Roadmap</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #161615;
        --fg: #ecece8;
        --muted: #a3a39c;
        --card: #22221f;
        --border: #3a3a36;
        --accent: #8aa8ff;
        --done-bg: #1f3a1f;
        --done-fg: #b5e3b5;
        --doing-bg: #22305a;
        --doing-fg: #c9d6ff;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); }
      header, main { max-width: 1200px; margin: 0 auto; padding: 1.5rem; }
      header { padding-bottom: 0; }
      h1 { margin: 0 0 0.25rem; font-size: 1.6rem; }
      .muted, .empty { color: var(--muted); }
      .summary p { margin: 0 0 1rem; }
      .board { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; align-items: start; }
      @media (max-width: 900px) { .board { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      /* On a phone the columns stack: In progress moves first, so that the work under way never
         comes after the backlog. Wider screens keep the classic kanban order of the markup. */
      @media (max-width: 560px) {
        .board { grid-template-columns: 1fr; }
        .column[data-column="doing"] { order: -1; }
      }
      .column h2 { font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 0.75rem; }
      .count { color: var(--muted); font-weight: normal; }
      /* Read by screen readers, never shown: the unit of a column's count ("2 cards"). */
      .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
      /* Without bullets, WebKit drops the list role of a <ul>: the card lists say role="list" in the markup. */
      /* One track that may shrink below its content: a card never grows wider than its column, even
         with a title kept on one line (its full width would otherwise size the track). */
      ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; }
      /* A word longer than a card is wide breaks instead of widening the card past its column. */
      .card { min-width: 0; background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem; overflow-wrap: anywhere; }
      .card h3 { margin: 0; font-size: 0.95rem; }
      /* Two levels of collapse: a closed card is its title on one line, cut with an ellipsis (the
         whole title stays in the markup, for screen readers and search); opened, the title wraps and
         the description, the steps toggle and the footer follow. */
      .card-toggle > summary { display: flex; align-items: baseline; gap: 0.4rem; cursor: pointer; list-style: none; }
      .card-toggle > summary::-webkit-details-marker { display: none; }
      .card-toggle > summary::before { content: "▸" / ""; color: var(--muted); }
      .card-toggle[open] > summary::before { content: "▾" / ""; }
      .card-toggle > summary h3 { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .card-toggle[open] > summary h3 { white-space: normal; overflow: visible; }
      /* An In progress card's progress, on its closed line beside the title, never cut. */
      .card-toggle > summary .progress { flex: none; font-size: 0.8rem; color: var(--muted); white-space: nowrap; }
      /* Open, the card shows its progress once, in its steps' toggle. */
      .card-toggle[open] > summary .progress { display: none; }
      /* The Done column's "Show all": its label says what a click will do. */
      .more { margin-top: 0.6rem; }
      .more > summary { cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--fg); margin-bottom: 0.6rem; }
      .more:not([open]) .when-open, .more[open] .when-closed { display: none; }
      .card p { margin: 0.4rem 0 0; font-size: 0.85rem; color: var(--muted); }
      .card footer { display: flex; gap: 0.5rem; margin-top: 0.6rem; font-size: 0.75rem; color: var(--muted); }
      .milestone { color: var(--accent); }
      .steps-toggle { margin-top: 0.6rem; font-size: 0.85rem; }
      .steps-toggle summary { cursor: pointer; color: var(--fg); font-weight: 600; }
      /* An explicit keyboard focus ring on every toggle (card, steps, Show all), the same in every
         browser (their defaults differ): checked for style, width and contrast by the end-to-end tests. */
      .column summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .steps-toggle .current { color: var(--muted); font-weight: normal; }
      .steps { list-style: decimal; padding-left: 1.2rem; margin: 0.4rem 0 0; display: grid; gap: 0.3rem; font-size: 0.85rem; }
      .step { color: var(--muted); }
      .step[data-status="done"] .step-title { text-decoration: line-through; }
      .step[data-status="doing"] { color: var(--fg); font-weight: 600; }
      .tag { display: inline-block; margin-left: 0.4rem; padding: 0 0.4rem; border-radius: 999px; font-size: 0.7rem; font-weight: 600; text-decoration: none; vertical-align: 1px; }
      .tag-done { background: var(--done-bg); color: var(--done-fg); }
      .tag-doing { background: var(--doing-bg); color: var(--doing-fg); }
      /* A card's review blocks: each a heading, its steps, and what ends it (styled by .card p). */
      .block { margin-top: 0.6rem; }
      .block h4 { margin: 0; font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <header>
      <h1>{view.title}</h1>
      <p class="muted">Public project roadmap: what is done, in progress and coming next.</p>
    </header>
    <main>
      <Board view={view} />
    </main>
  </body>
</html>
