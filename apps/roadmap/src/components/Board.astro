---
import { BLOCK_END, formatId, type StepWithStatus } from "../lib/board.ts";
import type { BoardProps as Props, CardView } from "../lib/view.ts";

const { view } = Astro.props;
---

<section class="summary" aria-label="Progress">
  <p>
    {
      view.columns.map((column, index) => (
        <span class="tally" data-tally={column.id}>
          {index > 0 && <span class="muted"> · </span>}
          <strong>{column.cards.length}</strong> {column.title}
        </span>
      ))
    }
    {view.lastUpdated !== null && <span class="muted"> · updated <time datetime={view.lastUpdated}>{view.lastUpdated}</time></span>}
  </p>
</section>

<div class="board">
  {
    view.columns.map((column) => {
      // Astro drops the whitespace between the elements of a callback's markup, so an element
      // read after another (a tag after a title, a milestone after a number) is preceded by an
      // explicit space, without which their texts run together ("InstallDone", "#1M1").
      // One step, numbered as the CLI's step commands number it: a block's list holds steps
      // that are not always consecutive, so each item carries its number.
      const stepItem = (step: StepWithStatus, number: number) => (
        <li class="step" value={number} data-status={step.status}>
          <span class="step-title">{step.title}</span>
          {step.status === "done" && [" ", <span class="tag tag-done">Done</span>]}
          {step.status === "doing" && [" ", <span class="tag tag-doing">In progress</span>]}
        </li>
      );
      // One card, collapsed to its title on one line (an In progress card adds its progress,
      // so that the work under way is seen without a click); opened, its description, steps
      // and footer. Defined once, rendered for the cards always shown and for those behind
      // "Show all".
      const cardItem = (card: CardView) => (
        <li class="card" data-id={card.id}>
          <details class="card-toggle">
            <summary>
              <h3>{card.title}</h3>
              {column.id === "doing" && card.steps.length > 0 && (
                <span class="progress">
                  Steps {card.doneSteps}/{card.steps.length}
                </span>
              )}
            </summary>
            {card.description !== "" && <p>{card.description}</p>}
            {card.steps.length > 0 && (
              <details class="steps-toggle">
                <summary>
                  Steps {card.doneSteps}/{card.steps.length}
                  {card.currentStep !== null && <span class="current"> · {card.currentStep}</span>}
                </summary>
                {card.groups.length > 0 && <p class="block-end">Each block ends with {BLOCK_END}.</p>}
                {card.groups.length === 0 ? (
                  <ol class="steps" aria-label="Steps">
                    {card.steps.map((step, i) => stepItem(step, i + 1))}
                  </ol>
                ) : (
                  card.groups.map((group) => {
                    // A plain division, not a region: one landmark per block would crowd the page's;
                    // the list is named by the block's heading instead.
                    const heading = `block-${String(card.id)}-${String(group.block ?? "none")}`;
                    return (
                      <div class="block" data-block={group.block ?? "none"}>
                        <h4 id={heading}>
                          {group.heading}
                          {group.done && [" ", <span class="tag tag-done">Done</span>]}
                        </h4>
                        <ol class="steps" aria-labelledby={heading}>{group.steps.map((step) => stepItem(step, step.number))}</ol>
                      </div>
                    );
                  })
                )}
              </details>
            )}
            <footer>
              <span class="id">{formatId(card.id)}</span>
              {card.milestone !== "" && [" ", <span class="milestone">{card.milestone}</span>]}
            </footer>
          </details>
        </li>
      );
      return (
        <section class="column" data-column={column.id} aria-labelledby={`col-${column.id}`}>
          <h2 id={`col-${column.id}`}>
            {column.title} <span class="count">{column.cards.length}<span class="visually-hidden"> {column.cards.length === 1 ? "card" : "cards"}</span></span>
          </h2>
          {column.cards.length === 0 ? (
            <p class="empty">Nothing yet</p>
          ) : (
            <ul role="list">{column.shown.map(cardItem)}</ul>
          )}
          {column.more.length > 0 && (
            <details class="more">
              <summary>
                <span class="when-closed">Show all {column.cards.length}</span>
                <span class="when-open">Show fewer</span>
              </summary>
              <ul role="list">{column.more.map(cardItem)}</ul>
            </details>
          )}
        </section>
      );
    })
  }
</div>
