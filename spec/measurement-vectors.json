{
  "scheme": "measurements/1",
  "vectors": [
    {
      "name": "tone-between-bins",
      "description": "A pure tone 105.34 bins from DC, between two bins, with a phase: no leakage and no scalloping, everything but the fundamental at the floor.",
      "rate": 48000,
      "frames": 4096,
      "fundamental": 1234.5,
      "tones": [
        {
          "frequency": 1234.5,
          "amplitude": 0.8,
          "phase": 0.7
        }
      ],
      "expected": {
        "fundamental": 0.8,
        "thd_plus_n": "floor",
        "sfdr": "floor",
        "harmonics": {
          "thd": "floor",
          "aliasing": "none",
          "snr": "floor"
        }
      }
    },
    {
      "name": "harmonics-in-band",
      "description": "1 kHz at full scale with its second harmonic at -60 dB and its third at -80 dB, over whole periods (so the sine fit sees no harmonic): THD = 20 log10(√(10^-6 + 10^-8)), the strongest spur the second harmonic.",
      "rate": 48000,
      "frames": 4800,
      "fundamental": 1000,
      "tones": [
        {
          "frequency": 1000,
          "amplitude": 1,
          "phase": 0
        },
        {
          "frequency": 2000,
          "amplitude": 0.001,
          "phase": 1.1
        },
        {
          "frequency": 3000,
          "amplitude": 0.0001,
          "phase": 2
        }
      ],
      "expected": {
        "fundamental": 1,
        "thd_plus_n": -59.95678626217358,
        "sfdr": 60,
        "harmonics": {
          "thd": -59.95678626217358,
          "aliasing": "none",
          "snr": "floor"
        }
      }
    },
    {
      "name": "aliased-harmonic",
      "description": "7 kHz at 48 kHz with its second harmonic (14 kHz) at -60 dB and its fifth (35 kHz, above Nyquist, folded to 13 kHz) at -80 dB, over whole periods: the aliasing level counts the fifth only.",
      "rate": 48000,
      "frames": 4800,
      "fundamental": 7000,
      "tones": [
        {
          "frequency": 7000,
          "amplitude": 0.5,
          "phase": 0
        },
        {
          "frequency": 14000,
          "amplitude": 0.0005,
          "phase": 0.4
        },
        {
          "frequency": 35000,
          "amplitude": 5e-05,
          "phase": 2.5
        }
      ],
      "expected": {
        "fundamental": 0.5,
        "thd_plus_n": -59.95678626217358,
        "sfdr": 60,
        "harmonics": {
          "thd": -59.95678626217358,
          "aliasing": -80,
          "snr": "floor"
        }
      }
    },
    {
      "name": "harmonic-at-nyquist",
      "description": "1 kHz at 8 kHz with its second harmonic at 0.05 and its fourth exactly at Nyquist, 0.01 · (-1)^n: a single basis function, of power 10^-4, so THD = 10 log10((0.05²/2 + 0.01²) / (1/2)); the harmonics above Nyquist all fold onto lower ones, DC or the fundamental, so there is no aliasing level.",
      "rate": 8000,
      "frames": 1000,
      "fundamental": 1000,
      "tones": [
        {
          "frequency": 1000,
          "amplitude": 1,
          "phase": 0
        },
        {
          "frequency": 2000,
          "amplitude": 0.05,
          "phase": 0.3
        },
        {
          "frequency": 4000,
          "amplitude": 0.01,
          "phase": 0
        }
      ],
      "expected": {
        "fundamental": 1,
        "thd_plus_n": -25.686362358410125,
        "sfdr": 26.020599913279625,
        "harmonics": {
          "thd": -25.686362358410125,
          "aliasing": "none",
          "snr": "floor"
        }
      }
    },
    {
      "name": "harmonic-folding-onto-the-fundamental",
      "description": "1 kHz at 8 kHz plus 0.25 at 7 kHz, which folds exactly onto 1 kHz with its phase negated: nothing tells it from the fundamental, which measures |1 + 0.25 e^(-0.5i)|.",
      "rate": 8000,
      "frames": 1000,
      "fundamental": 1000,
      "tones": [
        {
          "frequency": 1000,
          "amplitude": 1,
          "phase": 0
        },
        {
          "frequency": 7000,
          "amplitude": 0.25,
          "phase": 0.5
        }
      ],
      "expected": {
        "fundamental": 1.225271921226136,
        "thd_plus_n": "floor",
        "sfdr": "floor",
        "harmonics": {
          "thd": "floor",
          "aliasing": "none",
          "snr": "floor"
        }
      }
    },
    {
      "name": "dc-offset",
      "description": "440 Hz at 44.1 kHz on a DC offset of 0.3: DC is fitted, so it counts in no level.",
      "rate": 44100,
      "frames": 2000,
      "fundamental": 440,
      "tones": [
        {
          "frequency": 440,
          "amplitude": 0.5,
          "phase": 1
        },
        {
          "frequency": 0,
          "amplitude": 0.3,
          "phase": 0
        }
      ],
      "expected": {
        "fundamental": 0.5,
        "thd_plus_n": "floor",
        "sfdr": "floor",
        "harmonics": {
          "thd": "floor",
          "aliasing": "none",
          "snr": "floor"
        }
      }
    },
    {
      "name": "fundamental-not-binary32",
      "description": "1000.1 Hz, a binary64 frequency with every significant bit used, at 44.1 kHz: the phase is still reduced exactly.",
      "rate": 44100,
      "frames": 4096,
      "fundamental": 1000.1,
      "tones": [
        {
          "frequency": 1000.1,
