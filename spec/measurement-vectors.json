        "sfdr": "floor",
        "harmonics": {
          "thd": "floor",
          "aliasing": "none",
          "snr": "floor"
        }
      }
    },
    {
      "name": "harmonic-near-the-fundamental",
      "description": "16001 Hz at 48 kHz over 4096 frames (bins of 11.7 Hz): the second harmonic folds to 15998 Hz, a quarter of a bin from the fundamental, which the harmonic fit cannot tell apart; the sine fit, without harmonics, can.",
      "rate": 48000,
      "frames": 4096,
      "fundamental": 16001,
      "tones": [
        {
          "frequency": 16001,
          "amplitude": 1,
          "phase": 0
        }
      ],
      "expected": {
        "fundamental": 1,
        "thd_plus_n": "floor",
        "sfdr": "floor",
        "harmonics": "Unresolvable"
      }
    },
    {
      "name": "uniform-noise",
      "description": "997 Hz at full scale plus uniform noise of step 2^-20 (SplitMix64, seed 42): the expected SNR is 10 log10((1/2) / (2^-40 / 12)), and THD+N its negation, within the confidence interval of the specification.",
      "rate": 48000,
      "frames": 8192,
      "fundamental": 997,
      "tones": [
        {
          "frequency": 997,
          "amplitude": 1,
          "phase": 0
        }
      ],
      "noise": {
        "seed": 42,
        "step": 9.5367431640625e-07
      },
      "expected": {
        "fundamental": 1,
        "thd_plus_n": -128.1935107694289,
        "harmonics": {
          "snr": 128.1935107694289
        }
      }
    }
