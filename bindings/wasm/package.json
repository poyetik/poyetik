{
  "name": "@poyetik/engine-wasm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "poyetik engine in the browser (AudioWorklet) and in Node: the WebAssembly module and its TypeScript glue.",
  "exports": {
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "default": "./dist/hash.js"
    },
    "./worklet": "./dist/worklet/processors.js",
    "./engine.wasm": "./dist/engine.wasm"
  },
  "scripts": {
    "build:wasm": "cargo build --package engine-wasm --release --locked --target wasm32-unknown-unknown",
    "build": "pnpm build:wasm && tsc -p tsconfig.build.json && tsc -p ts/worklet/tsconfig.build.json && node scripts/copy-wasm.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ts/worklet",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:allocation": "vitest run --config vitest.allocation.config.ts",
    "test:mutation": "stryker run",
    "test:e2e": "tsc -p e2e/site/tsconfig.build.json && playwright test",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:allocation && pnpm test:mutation && pnpm test:e2e"
  },
  "devDependencies": {
    "@poyetik/config": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/audioworklet": "0.0.100",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
