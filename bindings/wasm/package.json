{
  "name": "@poyetik/engine-wasm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Poyetik engine in the browser (AudioWorklet): the WebAssembly module and its TypeScript glue. A Node entry point comes with the SDK (roadmap #5).",
  "exports": {
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "default": "./dist/hash.js"
    },
    "./worklet": "./dist/worklet/processors.js",
    "./engine.wasm": "./dist/engine.wasm"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.ts",
    "build": "pnpm build:wasm && tsc -p tsconfig.build.json && tsc -p ts/worklet/tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ts/worklet",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:reproducible": "node scripts/reproducible.ts",
    "test:allocation": "vitest run --config vitest.allocation.config.ts",
    "test:mutation": "stryker run",
    "test:e2e": "tsc -p e2e/site/tsconfig.build.json && playwright test",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:allocation && pnpm test:reproducible && pnpm test:mutation && pnpm test:e2e"
  },
  "devDependencies": {
    "@poyetik/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/audioworklet": "0.0.100",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  }
}
