{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "eslint.ts",
    "gates.ts",
    "one-line.ts",
    "playwright.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "disableTypeChecks": "eslint.ts"
}
