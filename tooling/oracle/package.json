{
  "name": "@poyetik/oracle",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "0.13.0",
  "type": "module",
  "exports": {
    "./inputs": "./src/inputs.ts",
    "./visual-inputs": "./src/visual-inputs.ts"
  },
  "description": "Independent conformance oracle: rereads the WAV file the native engine wrote for every case, recomputes its hash and checks the signal itself, with no code shared with the engine; reads the visual conformance cases too.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "oracle": "node src/bin.ts ../../conformance ../../target/conformance",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm oracle"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@poyetik/config": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
