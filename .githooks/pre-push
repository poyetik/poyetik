#!/bin/sh
# Before every push: the default check (`cargo xtask check`: every check of CI, mutation
# testing only the changes, Rust since the merge base with the upstream, TypeScript since the
# last local Stryker run; `--full`, every mutant, when a tag is pushed, and in CI), on exactly what is
# pushed: xtask refuses a working tree with uncommitted changes and a pushed commit other
# than the one checked out. A single failure blocks the push. Skipped (--no-verify) only in
# the two cases CLAUDE.md (CI) states: on the maintainer's explicit request for a push, or
# without asking when a full CI run checks the pushed commits before anything relies on them
# (a pull request's branch, or main followed by a full run), never for a tag.
set -eu

# Git clients do not always load the shell profile: make cargo reachable.
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

cd "$(git rev-parse --show-toplevel)"
# From a linked worktree, git hands the hook GIT_DIR, GIT_INDEX_FILE and other variables
# naming this repository. Every git command of the check would inherit them, and a test
# running git in a temporary directory would then act on this repository instead (setting
# core.bare, staging its files). The working directory alone now identifies the repository.
unset $(git rev-parse --local-env-vars)
# Git writes one line per pushed ref: <local ref> <local commit> <remote ref> <remote commit>.
# Each pushed commit goes with the remote ref it updates: a tag asks for the full check.
pushed=""
while read -r _local_ref local_commit remote_ref _remote_commit; do
  pushed="$pushed $local_commit $remote_ref"
done
cargo xtask pre-push $pushed
