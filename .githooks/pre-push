#!/bin/sh
# Before every push: exactly the same checks as CI (`cargo xtask check`).
# A single failure blocks the push. Never bypass it (no --no-verify).
set -eu

# Git clients do not always load the shell profile: make cargo reachable.
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

cd "$(git rev-parse --show-toplevel)"
cargo xtask check
